{
  "name": "fix-my-shit",
  "version": "2.0.7",
  "description": "Structured workflow assistant for Cursor — phased project management and issue resolution",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "fix-my-shit": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc && node scripts/copy-core.cjs",
    "start": "node dist/cli.js",
    "prepare": "husky",
    "lint": "eslint src scripts eslint.config.js",
    "lint:fix": "eslint src scripts eslint.config.js --fix",
    "format": "prettier \"src/**/*.{ts,js,cjs,mjs,json,md}\" \"scripts/**/*.{js,cjs,mjs}\" \"*.{json,js,md,yml,yaml}\" --write",
    "format:check": "prettier \"src/**/*.{ts,js,cjs,mjs,json,md}\" \"scripts/**/*.{js,cjs,mjs}\" \"*.{json,js,md,yml,yaml}\" --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "install": "npm run build && node dist/cli.js install",
    "check-npx-ready": "node scripts/check-npx-ready.js",
    "deploy": "bash scripts/deploy-npm.sh",
    "deploy:patch": "bash scripts/deploy-npm.sh patch",
    "deploy:minor": "bash scripts/deploy-npm.sh minor",
    "deploy:major": "bash scripts/deploy-npm.sh major"
  },
  "keywords": [
    "cursor",
    "workflow",
    "planning",
    "cli"
  ],
  "author": "Hurlatunde",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.2.23"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
